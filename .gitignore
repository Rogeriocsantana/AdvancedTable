# Arquivos temporários do Power BI Visuals Tools
/.tmp/
/webpack.statistics.*.html
*.log

# Certificados e segredos locais
*.pfx
*.p12
*.pem
*.key
.env
.env.*

# Sistema operacional e editores
.DS_Store
Thumbs.db
Desktop.ini
/.vscode/*
!/.vscode/settings.json
!/.vscode/launch.json
!/.vscode/tasks.json

# Resultados auxiliares da verificação de planilhas
/outputs/**/*.inspect.ndjson

