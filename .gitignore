/download-bridge/node_modules/
/download-bridge/.npm-cache/
/download-bridge/.next/
/download-bridge/.vinext/
/download-bridge/.package-stage-*/
/download-bridge/dist/
/download-bridge/out/
/download-bridge/coverage/
/download-bridge/.wrangler/
/download-bridge/.vercel/
/download-bridge/outputs/
/download-bridge/work/

